{#
 luci-theme-ctmodem - 光猫/网关风格主题 header
 参照天翼网关 Web 管理界面版式
 Licensed to the public under the MIT License.
-#}
{%
	import { getuid, getspnam } from 'luci.core';

	const board = ubus.call('system', 'board') ?? {};
	const hostname = board.hostname ?? 'OpenWrt';
	const devname = hostname;
	const modelname = board.model ?? '—';

	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="darkreader-lock">
	<title>{{ striptags(hostname) }}{% if (dispatched?.title): %} | {{ _(dispatched.title) }}{% endif %}</title>
	<link rel="stylesheet" href="{{ media }}/cascade.css?v=20261020">
	<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif %}
	{% if (css): %}
	<style title="text/css">{{ css }}</style>
	{% endif %}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
	<script src="{{ resource }}/cbi.js?v=20261020"></script>
</head>

<body class="lang_{{ dispatcher.lang }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
{% if (!blank_page): %}
<div id="page">

	<div id="gwhead">
		<div id="userbar">
			<div class="prov">OpenWrt 网关管理 · <em class="prov-val">{{ striptags(hostname) }}</em></div>
			<div class="userlinks">
				欢迎您！&nbsp;&nbsp;
				<a href="{{ dispatcher.build_url('admin/logout') }}">{{ _('Logout') }}</a>
			</div>
		</div>
	</div>

	<div id="gwmenu">
		<div id="menuloc">{{ _('Status') }}</div>
		<div id="menuarea">
			<div id="gwline">
				<span class="gwname">{{ _('Device') }}：{{ striptags(devname) }}</span>
				<span class="gwmodel">{{ _('Model') }}：{{ striptags(modelname) }}</span>
			</div>
			<ul id="topmenu"></ul>
			<ul id="tabmenu"></ul>
		</div>
	</div>

	<div id="gwbody">
		<div id="leftcol">
			<div id="lefttitle"></div>
			<ul id="leftmenu"></ul>
		</div>

		<div id="maincontent">

			{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
			<div class="alert-message warning">
				<h4>{{ _('No password set!') }}</h4>
				<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
				{% if (dispatcher.lookup('admin/system/admin')): %}
				<div class="right"><a class="btn" href="{{ dispatcher.build_url('admin/system/admin') }}">{{ _('Go to password configuration...') }}</a></div>
				{% endif %}
			</div>
			{% endif %}

			{% if (board.rootfs_type == 'initramfs'): %}
			<div class="alert-message warning">
				<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
				<p>{{ _('No changes to settings will be stored and are lost after rebooting.') }}</p>
			</div>
			{% endif %}

			<noscript>
				<div class="alert-message warning">
					<h4>{{ _('JavaScript required!') }}</h4>
					<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
				</div>
			</noscript>
{% endif %}
